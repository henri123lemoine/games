# Rust
**/target

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local
data/
.claude/
.worktrees/
# training-run outputs (net checkpoints + logs); published payloads live in R2
/runs/
/ml/*/runs/

# wasm build outputs; .asset-cache holds R2-fetched payload bytes
# (tools/fetch-asset.sh) — the nets themselves live in the arcade-assets
# bucket, recorded by web/app/asset-manifest.json, never in git
target-wasm/
web/engine/pkg/
web/slither-engine/pkg/
web/app/node_modules/
web/app/dist/
web/app/.validation/
web/app/.asset-cache/

# doomrl C build output (compiled .o objects + the doomrl_driver binary)
doomrl/build/

# Third-party calibration dependencies: fetched at pinned revisions by
# ml/stratego-trainer/calibration/fetch_vendor.sh, never tracked here.
ml/stratego-trainer/calibration/vendor/

__pycache__/
