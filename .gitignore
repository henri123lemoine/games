# Rust
**/target

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local
data/
.claude/
.worktrees/
# training-run outputs (net checkpoints + logs); the final published net is
# committed under web/app/public/artifacts/, not here
/runs/

# wasm build outputs (public/artifacts/ and public/azero/ are NOT ignored:
# published nets and their validation fixtures are committed so CI and
# clones get them with no side channel)
target-wasm/
web/engine/pkg/
web/slither-engine/pkg/
web/app/node_modules/
web/app/dist/
web/app/.validation/

# doomrl C build output (compiled .o objects + the doomrl_driver binary)
doomrl/build/

# Vendored calibration agents: keep the third-party sources, never their
# local build outputs or macOS archive cruft.
ml/stratego-trainer/calibration/vendor/strategoevaluator/agents/**/*.o
ml/stratego-trainer/calibration/vendor/strategoevaluator/agents/**/*.o.dep
ml/stratego-trainer/calibration/vendor/strategoevaluator/agents/**/__MACOSX/
ml/stratego-trainer/calibration/vendor/strategoevaluator/agents/**/._*
ml/stratego-trainer/calibration/vendor/strategoevaluator/agents/peternlewis/peternlewis
ml/stratego-trainer/calibration/vendor/strategoevaluator/agents/ramen/ramen
