<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Template: launchd cannot expand $HOME, so the install step substitutes
     the __REPO__ and __HOME__ placeholders (see mirror_training_runs.sh). -->
<dict>
    <key>Label</key>
    <string>com.henrilemoine.trainingmirror</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/tools/mirror_training_runs.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/TrainingMirror/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/TrainingMirror/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
